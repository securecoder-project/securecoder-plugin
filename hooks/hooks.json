{
  "description": "SecureCoder hooks for Claude Code and Codex: fast SAST on edited files, a high-signal shell command guard, and the core secure-coding constraints added to every prompt. All three read .securecoder.json settings and do nothing when SecureCoder is disabled.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/securecoder-hook.js\" post-edit",
            "timeout": 180,
            "statusMessage": "SecureCoder: scanning edited files"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/securecoder-hook.js\" pre-shell",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/securecoder-hook.js\" user-prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
