{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash -c 'FILE=$(jq -r \".tool_input.file_path // .tool_input.path // empty\"); [ -z \"$FILE\" ] && exit 0; \"${CLAUDE_PLUGIN_ROOT}/scripts/run-sast\" \"$FILE\"'",
                        "description": "Run the SecureCoder fast guardian pipeline on any file written or edited by Claude"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-bash-command",
                        "description": "Warn on shell injection patterns in bash commands Claude is about to run"
                    }
                ]
            }
        ]
    }
}
