flowchart LR
  DEV(["👨‍💻 Developer<br/><i>&quot;Add a feature to …&quot;</i>"])

  subgraph CC["Claude Code (agent loop)"]
    direction TB
    SKILL["<b>② secure-codegen skill</b><br/>auto-invoked on codegen"]
    CLAUDE(("<b>④ Claude</b><br/>writes the code"))
    HOOK["<b>⑤ PostToolUse hook</b><br/>run-sast on Write / Edit"]
    REM["<b>⑦ Remediator agent</b><br/>fix, then re-check"]
  end

  subgraph MCP["securecoder-analysis (MCP server, Node, zero deps)"]
    direction TB
    ENRICH["<b>③ enrich_prompt</b><br/>contract-preserving constraints"]
    GUARD["<b>⑥ Guardian pipeline</b><br/>syntax · semgrep · bandit · CodeQL"]
    RETRY["<b>⑧ Retry sessions</b><br/>verdict: continue or clean"]
  end

  DEV -- "① prompt" --> SKILL
  SKILL -- "task" --> ENRICH
  ENRICH -- "constraints" --> SKILL
  SKILL -- "security-first prompt" --> CLAUDE
  CLAUDE -- "code (Write / Edit)" --> HOOK
  HOOK -- "files" --> GUARD
  GUARD -- "findings, into context" --> CLAUDE
  CLAUDE -- "if findings" --> REM
  REM -- "analyze (deep)" --> GUARD
  GUARD -- "results" --> RETRY
  RETRY -- "verdict" --> REM
  REM -- "✓ clean code" --> DEV

  classDef dev fill:#F6F7F9,stroke:#22262F,stroke-width:1.5px,color:#22262F
  classDef cc fill:#FBF1EC,stroke:#D97757,stroke-width:1.5px,color:#22262F
  classDef mcp fill:#EDF7F4,stroke:#2FA68C,stroke-width:1.5px,color:#22262F
  class DEV dev
  class SKILL,CLAUDE,HOOK,REM cc
  class ENRICH,GUARD,RETRY mcp
  style CC fill:#FFFFFF,stroke:#9AA3B2,stroke-width:1.5px,stroke-dasharray:6 4
  style MCP fill:#FFFFFF,stroke:#9AA3B2,stroke-width:1.5px,stroke-dasharray:6 4
