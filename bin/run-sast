#!/usr/bin/env bash
# run-sast — adapter between Claude Code hooks and the SecureCoder pipeline.
# Prefers the bundled Node guardian pipeline (mcp-server/cli.js: syntax
# hard-reject checks + semgrep + bandit, same code as the MCP server); falls
# back to direct bandit/semgrep invocation when Node is unavailable.
# Output format: one finding per line, prefixed with severity tag.
# Exit 0 always (non-zero exit blocks the hook chain).

set -uo pipefail

FILE="${1:-}"
if [ -z "$FILE" ] || [ ! -f "$FILE" ]; then
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(dirname "$SCRIPT_DIR")"
FINDINGS=""

if command -v node &>/dev/null; then
  # Fast guardians only — CodeQL (deep) runs via the MCP tool on demand.
  FINDINGS=$(node "$PLUGIN_ROOT/mcp-server/cli.js" "$FILE" 2>/dev/null || true)
else
  # ── Fallback: direct tool invocation ─────────────────────────────────────
  EXT="${FILE##*.}"
  case "$EXT" in
    py)
      if command -v bandit &>/dev/null; then
        FINDINGS=$(bandit -q -f custom \
          --msg-template "[{severity}] {test_id} line {line}: {msg}" \
          "$FILE" 2>/dev/null || true)
      fi
      ;;
    js|ts|jsx|tsx)
      if command -v semgrep &>/dev/null; then
        FINDINGS=$(semgrep --config=p/javascript --config=p/typescript \
          --quiet --no-git-ignore \
          --output-format=text "$FILE" 2>/dev/null || true)
      fi
      ;;
    *)
      if command -v semgrep &>/dev/null; then
        FINDINGS=$(semgrep --config=auto --quiet --no-git-ignore \
          --output-format=text "$FILE" 2>/dev/null || true)
      fi
      ;;
  esac
fi

if [ -z "$FINDINGS" ]; then
  exit 0
fi

# Emit findings to stdout — Claude Code injects hook stdout back into context.
echo "SAST FINDINGS for $FILE:"
echo "$FINDINGS"
echo ""
echo "Invoke the securecoder-remediator agent to address the above findings."
echo "For deep analysis (CodeQL), call the securecoder_analyze MCP tool with deep=true."
