{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "securecoder",
  "displayName": "SecureCoder",
  "version": "0.3.0",
  "description": "Security-aware code generation: contract-preserving security constraints before generation, SAST on every edit (syntax, semgrep, bandit; CodeQL on demand), and a guided remediation loop. Configure with /securecoder:securecoder.",
  "author": {
    "name": "parsakaz",
    "url": "https://github.com/parsakaz"
  },
  "homepage": "https://securecoder-project.github.io/",
  "repository": "https://github.com/securecoder-project/securecoder-plugin",
  "license": "MIT",
  "keywords": ["security", "sast", "owasp", "codeql", "semgrep", "bandit", "remediation", "code-generation"],
  "mcpServers": {
    "securecoder-analysis": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/index.js"]
    }
  }
}
